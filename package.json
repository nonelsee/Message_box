{
  "name": "workspace-chat",
  "productName": "Workspace Chat",
  "version": "1.2.0",
  "description": "Personal messenger wrapper with a Teams-inspired dark theme",
  "author": "Workspace Chat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win --publish never",
    "release-win": "electron-builder --win --publish always",
    "build-mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.personal.workspacechat",
    "productName": "Workspace Chat",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "nonelsee",
        "repo": "Message_box",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workspace Chat",
      "uninstallDisplayName": "Workspace Chat",
      "artifactName": "Workspace-Chat-Setup.${ext}"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": "dir"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
